# Supabase — get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — your live site URL (e.g. https://your-app.vercel.app). Used as a server fallback.
# NEXT_PUBLIC_SITE_URL=

# Groq — get from: https://console.groq.com/keys
GROQ_API_KEY=
# Optional model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Pollinations — required for cover art on Vercel (https://enter.pollinations.ai/keys)
POLLINATIONS_API_KEY=
